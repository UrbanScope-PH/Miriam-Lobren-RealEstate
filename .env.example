# UrbanScope Environment Configuration
# Copy this file to `.env` and fill in your credentials:
#   cp .env.example .env

# Environment Mode ('development' or 'production')
URBANSCOPE_ENV=development
HOST=127.0.0.1
PORT=8000
FORCE_HTTPS=false
ENABLE_API_DOCS=true
# Comma-separated allowed CORS origins (leave empty in local dev for localhost/127.0.0.1 defaults)
ALLOWED_ORIGINS=https://miriam-lobren-real-estate.vercel.app,https://miriamlobren.site

# JWT Signing Secret (REQUIRED in production; generate >= 32 random chars: openssl rand -hex 32)
URBANSCOPE_SECRET_KEY=

# Vercel session signing secret (REQUIRED in production; >= 32 random chars: openssl rand -base64 48)
VERCEL_ADMIN_SESSION_SECRET=

# Optional comma-separated additional Google email addresses authorized for the Vercel Admin portal.
VERCEL_ADMIN_EMAILS=

# Google OAuth 2.0 Web Client ID (Google Identity Services)
GOOGLE_CLIENT_ID=981770655747-t222jr0ias09rl7aga3302p9am64so43.apps.googleusercontent.com

# Email OTP for password registration and password recovery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=UrbanScope <noreply@miriamlobren.site>
# Private HMAC key >= 32 chars (for example: openssl rand -hex 32)
AUTH_OTP_SECRET=

# Supabase server key. Server-side only; REQUIRED for production API routes and locked-down RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Cloudflare Turnstile Bot Protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional local dev bootstrap passwords (only used in development when creating initial SQLite users)
SEED_SUPERADMIN_PASSWORD=
SEED_MIRIAM_PASSWORD=
SEED_ADMIN_PASSWORD=
